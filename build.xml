<?xml version="1.0" encoding="UTF-8"?>
<project name="ShareTools" default="jar" basedir=".">
    <property name="classes.dir" location="build/classes"/>
    <property name="dist.dir" location="dist"/>
    <property name="driver.jar" location="lib/mysql-connector-j-8.4.0.jar"/>
    <property name="main.class" value="Principal.Principal"/>

    <target name="compile">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="src" destdir="${classes.dir}" release="17" encoding="UTF-8" includeantruntime="false"/>
        <copy todir="${classes.dir}/Imagens">
            <fileset dir="src/Imagens"/>
        </copy>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}/lib"/>
        <copy file="${driver.jar}" todir="${dist.dir}/lib"/>
        <jar destfile="${dist.dir}/ShareTools.jar" basedir="${classes.dir}" manifest="manifest.mf"/>
    </target>

    <target name="run" depends="jar">
        <java jar="${dist.dir}/ShareTools.jar" fork="true" failonerror="true"/>
    </target>

    <target name="clean">
        <delete dir="build"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
